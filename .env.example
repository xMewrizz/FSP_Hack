POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp_secret
POSTGRES_DB=fsp_career
DATABASE_URL=postgresql+psycopg://fsp:fsp_secret@localhost:5432/fsp_career
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-prod
ML_SERVICE_URL=http://localhost:8001
# Для локального backend без Compose изолированный исполнитель не запускается.
SANDBOX_SERVICE_URL=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Для облачной модели: LLM_PROVIDER=openrouter и личный ключ ниже.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Другой облачный провайдер: LLM_PROVIDER=listapi; ключ хранится только на сервере.
LIST_API_KEY=
LIST_API_MODEL=gpt-5.6-sol
VITE_API_URL=http://localhost:8000/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=5173
